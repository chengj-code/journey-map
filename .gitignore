# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vue SFC compiled output (should not be committed)
*.vue.js

# TypeScript project: prevent duplicate JS source files
# (This is a TS project - JS files are generated during build, not committed)
/src/*.js
/src/**/*.js
!/src/**/*.{test,spec}.js

# Config files: prefer .ts versions over .js
/vite.config.js
/tailwind.config.js
/postcss.config.js
/eslint.config.*.js
/.eslintrc.*.js
/babel.config.*.js
/jest.config.*.js
